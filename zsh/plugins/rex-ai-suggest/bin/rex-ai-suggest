        "rex-ai-toggle",
        "rex-ai-status",
        "rex-ai-test",
    }
)

HIGH_SIGNAL_COMMANDS = frozenset(
    {
        "git",
        "npm",
        "pnpm",
        "yarn",
        "bun",
        "npx",
        "cargo",
        "go",
