#!/usr/bin/env python3
"""Proactive and on-demand Gemini command suggestion helper for Rex + Zsh."""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import urllib.error
import urllib.request
from pathlib import Path

DEFAULT_MODEL = "gemini-3.5-flash-lite"
DEFAULT_API_BASE_URL = "https://generativelanguage.googleapis.com/v1beta"
DEFAULT_PROACTIVE_MODE = "smart"
DEFAULT_KEYCHAIN_SERVICE = "rex-ai-gemini"
DEFAULT_CAPTURE_LINES = 60
DEFAULT_CAPTURE_CHARS = 4000
MAX_SUGGESTION_CHARS = 300

TRIVIAL_COMMANDS = frozenset(
    {
        "cd",
        "ls",
